# ─── Core ────────────────────────────────────────────────────────────────────
APP_NAME=Blinkit Stock Sentinel
ENVIRONMENT=local           # local | staging | production
API_V1_PREFIX=/api/v1

# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-generate-a-real-secret

# ─── Database ────────────────────────────────────────────────────────────────
# Docker Compose default (matches docker-compose.yml postgres service):
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
# Railway / Render / Supabase: paste the connectionString here (postgres:// is auto-converted)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Upstash (TLS): rediss://... — ssl_cert_reqs=none is added automatically

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for development
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── HTTPS ───────────────────────────────────────────────────────────────────
FORCE_HTTPS=false           # set true on Railway / Render production

# ─── Bootstrap ───────────────────────────────────────────────────────────────
# Set true on first start to auto-create tables (alternative to schema.sql)
BOOTSTRAP_MODE=false

# ─── Provider templates ──────────────────────────────────────────────────────
# Configure your own ToS-compliant endpoint templates captured from live traffic.
# The app will NOT fabricate inventory — if these are missing, all provider calls
# fail closed with a clear LIVE_PROVIDER_NOT_CONFIGURED error.
#
# Placeholders: {query}, {product_id}, {pincode}, {lat}, {lon}
BLINKIT_SEARCH_URL_TEMPLATE=
BLINKIT_PRODUCT_URL_TEMPLATE=

# Optional extra headers sent with every provider request (JSON object):
# BLINKIT_HEADERS={"Accept-Language": "en-IN"}

# ─── Polling ─────────────────────────────────────────────────────────────────
DEFAULT_POLL_INTERVAL_SECONDS=900
MIN_POLL_INTERVAL_SECONDS=300
STOCK_RESPONSE_MAX_AGE_SECONDS=120
DUPLICATE_ALERT_WINDOW_SECONDS=1800

# ─── Provider safety ─────────────────────────────────────────────────────────
PROVIDER_BASE_DELAY_SECONDS=1.5
PROVIDER_MAX_REQUESTS_PER_MINUTE=30
PROVIDER_TIMEOUT_SECONDS=12

# ─── Playwright (browser provider) ───────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_SECONDS=30

# ─── Celery ──────────────────────────────────────────────────────────────────
# prefork (default) for production, solo for local debugging
CELERY_WORKER_POOL=prefork

# ─── Worker healthcheck ──────────────────────────────────────────────────────
# Must differ from PORT (API port) when running on the same host
WORKER_HEALTH_PORT=8001

# ─── Firebase Cloud Messaging ────────────────────────────────────────────────
# Path to service-account JSON file downloaded from Firebase console
# FCM_CREDENTIALS_PATH=/secrets/fcm-service-account.json

# ─── Observability ───────────────────────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...

# ─── Debug / dev only ────────────────────────────────────────────────────────
EXPOSE_INTERNAL_ERRORS=false
# Set true to allow unauthenticated access from the Android dev device
ALLOW_INTERNAL_DEVICE_ANONYMOUS_AUTH=false
