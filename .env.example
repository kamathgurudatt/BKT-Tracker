APP_NAME="Blinkit Stock Sentinel"
ENVIRONMENT=local
SECRET_KEY=replace-with-a-strong-random-secret
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinel
REDIS_URL=redis://redis:6379/0
PROVIDER_BASE_DELAY_SECONDS=1.5
PROVIDER_MAX_REQUESTS_PER_MINUTE=30
DEFAULT_POLL_INTERVAL_SECONDS=900
MIN_POLL_INTERVAL_SECONDS=300
FCM_CREDENTIALS_PATH=
SMTP_URL=
EMAIL_FROM=

# Real-data mode: configure only public/ToS-compliant Blinkit endpoints observed from your own app/web traffic.
# Supported placeholders: {query}, {product_id}, {pincode}, {lat}, {lon}
BLINKIT_SEARCH_URL_TEMPLATE=
BLINKIT_PRODUCT_URL_TEMPLATE=
LIVE_PROVIDER_REQUIRED=true
STOCK_CONFIRMATION_DELAY_SECONDS=2
STOCK_RESPONSE_MAX_AGE_SECONDS=120
DUPLICATE_ALERT_WINDOW_SECONDS=1800
