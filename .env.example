# Core
ENVIRONMENT=production
APP_NAME=Blinkit Stock Sentinel
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-strong-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloud data stores
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
UPSTASH_REDIS_REST_URL=https://moral-giraffe-123165.upstash.io
UPSTASH_REDIS_REST_TOKEN=UPSTASH_REDIS_REST_TOKEN=gQAAAAAAAeEdAAIgcDE0ZWFmYTVmN2IyMzM0ZjRlYTg4YWQ5MmFmYzBhOWRkYw
REDIS_URL="rediss://default:gQAAAAAAAeEdAAIgcDE0ZWFmYTVmN2IyMzM0ZjRlYTg4YWQ5MmFmYzBhOWRkYw@moral-giraffe-123165.upstash.io:6379

# Public API + security
CORS_ORIGINS=["https://your-android-web-admin.example.com","https://<your-railway-domain>.up.railway.app"]
FORCE_HTTPS=false
TRUST_PROXY_HEADERS=true
BOOTSTRAP_MODE=true
DEPENDENCY_RETRY_INTERVAL_SECONDS=20

# Providers (required for live inventory)
BLINKIT_SEARCH_URL_TEMPLATE=
BLINKIT_PRODUCT_URL_TEMPLATE=
LIVE_PROVIDER_REQUIRED=true
BLINKIT_HEADERS={"x-client":"your-client-header"}

# Polling
DEFAULT_POLL_INTERVAL_SECONDS=900
MIN_POLL_INTERVAL_SECONDS=300
STOCK_RESPONSE_MAX_AGE_SECONDS=120
DUPLICATE_ALERT_WINDOW_SECONDS=1800

# Push notifications
FCM_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json

# Optional monitoring
SENTRY_DSN=
