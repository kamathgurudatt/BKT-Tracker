# Core
ENVIRONMENT=production
APP_NAME=Blinkit Stock Sentinel
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-strong-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloud data stores
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
REDIS_URL=redis://default:PASSWORD@HOST:6379/0

# Public API + security
CORS_ORIGINS=["https://your-android-web-admin.example.com","https://your-backend.onrender.com"]
FORCE_HTTPS=true
TRUST_PROXY_HEADERS=true

# Providers (required for live inventory)
BLINKIT_SEARCH_URL_TEMPLATE=https://authorized.example/search?q={query}&lat={lat}&lon={lon}&pincode={pincode}
BLINKIT_PRODUCT_URL_TEMPLATE=https://authorized.example/product/{product_id}?lat={lat}&lon={lon}&pincode={pincode}
LIVE_PROVIDER_REQUIRED=true
BLINKIT_HEADERS={"x-client":"your-client-header"}

# Polling
DEFAULT_POLL_INTERVAL_SECONDS=900
MIN_POLL_INTERVAL_SECONDS=300
STOCK_RESPONSE_MAX_AGE_SECONDS=120
DUPLICATE_ALERT_WINDOW_SECONDS=1800

# Push notifications
FCM_CREDENTIALS_PATH=/etc/secrets/firebase-service-account.json

# Optional monitoring
SENTRY_DSN=
