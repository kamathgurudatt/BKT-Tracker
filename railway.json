{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "backend/**",
      "railway.json",
      "Procfile"
    ],
    "dockerfilePath": "backend/Dockerfile",
    "buildEnvironment": "V3"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "healthcheckTimeout": 300,
    "restartPolicyMaxRetries": 10
  }
}
